{
    "keyboard_name": "Nest Raven",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "bootloader_instructions": "Hold the BOOT button while plugging in the usb cable",
    "diode_direction": "COL2ROW",
    "tags": ["ortho", "split"],
    "url": "https://github.com/fishjord/nest-keyboard",
    "usb": {
        "device_version": "0.0.1",
        "vid": "0x4E45",
        "pid": "0x0005"
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "cols": ["GP8", "GP7", "GP6", "GP5", "GP4", "GP3"],
        "rows": ["GP28", "GP27", "GP26", "GP15", "GP14"]
    },
    "split": {
	    "bootmagic": {
		    "matrix": [5, 0]
	    },
	    "enabled": true,
	    "serial": {
		    "driver": "vendor"
	    },
	    "transport": {
		    "sync": {
			    "layer_state": true,
			    "matrix_state": true
		    }
	    }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "`", "matrix": [0, 0], "x": 0, "y": 0.7},
